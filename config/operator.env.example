# Copy this file to config/operator.env and fill in values.
# This file is used by scripts/norma-runner.sh for one-click startup.

# Required: Robot IP for Norma/Pepper.
ROBOT_IP=192.168.1.155

# Optional: Operator machine LAN IP.
# If empty, scripts auto-detect it.
OPERATOR_IP=

# Optional overrides (defaults are shown).
BRIDGE_PORT=8080
PROXY_PORT=5000
BRIDGE_PATH=../pepper-robot-bridge
